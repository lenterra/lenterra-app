# Copy to .env. Everything here is EXPO_PUBLIC_*, which means it is embedded in
# the bundle and readable by anyone with the APK. None of it is a secret.
#
# The assertion HMAC secret is deliberately absent — it lives only on the
# verifier and the Nakama server, and a build that contained it would let any
# client mint its own identity.

EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_CLIENT_VERSION=0.1.0

# Nakama. Not 127.0.0.1 — that only resolves on a simulator loopback, which is
# why the demo could never talk to a real server from a physical device.
EXPO_PUBLIC_NAKAMA_HOST=192.168.1.10
EXPO_PUBLIC_NAKAMA_PORT=7350
EXPO_PUBLIC_NAKAMA_SSL=false
# Not 'defaultkey'. That is Nakama's published default.
EXPO_PUBLIC_NAKAMA_SERVER_KEY=lenterra-localdev-key

EXPO_PUBLIC_VERIFIER_URL=http://192.168.1.10:8787
EXPO_PUBLIC_THIRDWEB_CLIENT_ID=
